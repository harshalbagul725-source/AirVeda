# Copy to .env for local use. Set private values in Vercel project settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ENVIRONMENT=production
CACHE_TTL_SECONDS=900
AI_RATE_LIMIT=30/minute
API_RATE_LIMIT=120/minute

# Same-origin frontend/API requests do not require CORS. Add trusted origins
# only if browser clients on other origins need to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
