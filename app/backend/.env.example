# Environment Configuration Example
# Copy to .env and set your values

# Google Gemini API Key (optional - built-in expert fallback engine runs if omitted)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Security: CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Cache Configuration
CACHE_TTL_SECONDS=900

# Rate Limiting
AI_RATE_LIMIT=30/minute
API_RATE_LIMIT=120/minute

